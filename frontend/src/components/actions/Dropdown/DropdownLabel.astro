---
import { cn } from "@utils/styles.utils";
import type { HTMLAttributes } from "astro/types";

import { dropdownLabelVariants } from "./variants";

/**
 * @component DropdownLabel
 * @title Dropdown Label
 * @description Section label for grouping items inside dropdown content. Renders as a non-interactive element.
 *
 * @preview
 *
 * <Dropdown>
 *   <DropdownTrigger class="rounded-md border px-3 py-2">Open</DropdownTrigger>
 *   <DropdownContent>
 *     <DropdownLabel>Account</DropdownLabel>
 *     <DropdownItem>Profile</DropdownItem>
 *   </DropdownContent>
 * </Dropdown>
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import { DropdownLabel } from "@components/actions/Dropdown";
 * ---
 *
 * <DropdownLabel>Account</DropdownLabel>
 * ```
 */

interface Props extends HTMLAttributes<"div"> {
  /**
   * When true, adds left padding so the label aligns with items that have a
   * leading icon or checkbox indicator.
   * @default false
   */
  inset?: boolean;
}

const { class: className, inset = false, ...rest } = Astro.props as Props;
---

<div
  class={cn(dropdownLabelVariants({ inset }), className)}
  role="presentation"
  {...rest}
>
  <slot />
</div>
