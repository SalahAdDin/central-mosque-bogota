---
import HomeSection from "./HomeSection.astro";
---

<HomeSection
  title="Próximos Eventos"
  description="Únete a nuestras actividades comunitarias y fortalece tu fe."
  ctaLabel="Ver calendario completo"
  ctaHref="/events"
  bodyClass="grid grid-cols-1 gap-8 md:grid-cols-3"
>
  <li class="
    rounded-xl border border-slate-200 p-6
    dark:border-slate-700
  "
  >
    <h3 class="mb-2 font-bold">Cena Comunitaria</h3>
    <p class="text-slate-500">Un espacio para compartir alimentos.</p>
  </li>
  <li class="
    rounded-xl border border-slate-200 p-6
    dark:border-slate-700
  "
  >
    <h3 class="mb-2 font-bold">Clase de Tajwīd</h3>
    <p class="text-slate-500">Reglas de recitación del Corán.</p>
  </li>
  <li class="
    rounded-xl border border-slate-200 p-6
    dark:border-slate-700
  "
  >
    <h3 class="mb-2 font-bold">Introducción al Islam</h3>
    <p class="text-slate-500">Sesión abierta para conocer los pilares de la fe.</p>
  </li>
</HomeSection>
